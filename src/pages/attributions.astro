---
// Full attribution index — linked from the footer of the main page.
// Lists every Commons image with author, license, and source link, and
// documents where the rest of the site's content comes from.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import manifest from '../../data/attributions.json';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Attributions — AK12"
  description="Image credits, licenses, and content sources for the AK12 fan site."
>
  {/* id/tabindex match Base.astro's skip-link target on every page */}
  <main class="section" id="story" tabindex="-1">
    <div class="container">
      <p class="kicker">AK12 · Credits</p>
      <h1>Attributions & sources</h1>

      <section aria-labelledby="images-h">
        <h2 id="images-h">Images</h2>
        <p>
          All photographs are from
          <a href="https://commons.wikimedia.org/" rel="external noopener">Wikimedia Commons</a>
          under open licenses, verified programmatically before use. Click any
          source link for the original file and full license terms.
        </p>
        <ul class="credits" role="list">
          {manifest.images.map((img) => (
            <li>
              {/* decorative: the visible credit beside it carries the
                  information, and img.title is a raw Commons filename */}
              <img
                src={`${base}/images/commons/${img.file}`}
                alt=""
                width={img.width}
                height={img.height}
                loading="lazy"
                decoding="async"
              />
              <div>
                <p class="title">{img.title}</p>
                <p>
                  {img.author} ·
                  {img.licenseUrl ? <a href={img.licenseUrl} rel="external noopener license">{img.license}</a> : img.license}
                  {/* sr-only suffix keeps 33 repeated "Source" links distinct */}
                  · <a href={img.sourceUrl} rel="external noopener">
                      Source<span class="sr-only"> — photo by {img.author}, {img.license}</span>
                    </a>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="video-h">
        <h2 id="video-h">Video</h2>
        <p>
          All race footage is embedded directly from official YouTube channels
          (Formula 1, Mercedes-AMG PETRONAS) using YouTube's iframe embed API.
          No footage is hosted, downloaded, or reproduced by this site.
        </p>
      </section>

      <section aria-labelledby="data-h">
        <h2 id="data-h">Data</h2>
        <p>
          Race results and standings from the
          <a href="https://api.jolpi.ca/" rel="external noopener">Jolpica F1 API</a>.
          Junior-career records verified against the sources cited inline
          throughout the site.
        </p>
      </section>

      <p><a href={`${base}/`}>← Back to the story</a></p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  h1 {
    margin-block: 0.8rem 2rem;
    font-size: clamp(2.4rem, 6vw, 4rem);
  }

  h2 {
    margin-block: 2.4rem 0.8rem;
    font-size: 1.5rem;
    color: var(--c-teal-bright);
  }

  .credits {
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
    display: grid;
    gap: 1.1rem;
  }

  .credits li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.8rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    font-size: 0.85rem;
    color: var(--c-text-dim);
  }

  .credits img {
    width: 100%;
    height: 5.5rem;
    object-fit: cover;
    border-radius: 6px;
  }

  .credits .title {
    font-weight: 700;
    color: var(--c-text);
  }

  @media (max-width: 30rem) {
    .credits li {
      grid-template-columns: 1fr;
    }
  }
</style>
